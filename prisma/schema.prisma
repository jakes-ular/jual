// Prisma schema for the Roblox asset marketplace.
//
// PRODUCTION DATABASE: PostgreSQL (via DATABASE_URL). Originally scaffolded
// against SQLite for a sandbox with no Docker/Postgres available — the schema
// intentionally avoids native Postgres-only types (enums, arrays) so that
// move required no model changes, only this datasource block.
// Local dev can still point DATABASE_URL at a local Postgres instance, or at
// `file:./dev.db` with provider flipped back to "sqlite" if you need to work
// offline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (stored as plain strings for SQLite compatibility) ----------
// Role: "USER" | "ADMIN"
// UserStatus: "ACTIVE" | "SUSPENDED"
// ProductStatus: "PUBLISHED" | "DRAFT"
// OrderStatus: "PENDING" | "PAID" | "FAILED" | "CANCELLED" | "EXPIRED"
// PaymentMethod: "QRIS" | "GOPAY" | "OVO" | "DANA" | "SHOPEEPAY" | "BANK_TRANSFER" | "VIRTUAL_ACCOUNT"
// PaymentStatus: "PENDING" | "SUCCESS" | "FAILED" | "EXPIRED"

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("USER")
  status        String    @default("ACTIVE")
  suspensionReason String?
  avatarUrl     String?
  emailVerified DateTime? // null until the signup verification code is confirmed
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  downloads     Download[]
  appeals       Appeal[]
  verificationTokens EmailVerificationToken[]
  topupOrders   TopupOrder[]

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   // bcrypt hash of the 6-digit code, never stored in plaintext
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  shortDescription String?
  description     String
  price           Int       // stored in Rupiah, integer, no decimals
  discountPrice   Int?
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  tags            String    @default("") // comma-separated tags for search
  features        String    @default("") // newline-separated feature bullets
  fileFormat      String?
  fileSize        String?
  compatibility   String?
  version         String?
  changelog       String?
  status          String    @default("DRAFT") // PUBLISHED | DRAFT
  isFeatured      Boolean   @default(false)
  isBestSeller    Boolean   @default(false)
  salesCount      Int       @default(0)
  ratingAvg       Float     @default(0)
  ratingCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  images          ProductImage[]
  files           ProductFile[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]

  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  storagePath String
  sizeBytes Int
  createdAt DateTime @default(now())

  downloads Download[]

  @@index([productId])
}

model Order {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyerName     String
  buyerEmail    String
  buyerContact  String
  subtotal      Int
  total         Int
  status        String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | EXPIRED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?

  items         OrderItem[]
  payment       Payment?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   // snapshot at time of purchase
  unitPrice   Int      // snapshot at time of purchase
  quantity    Int      @default(1)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String    // QRIS | GOPAY | OVO | DANA | SHOPEEPAY | BANK_TRANSFER | VIRTUAL_ACCOUNT
  status        String    @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED
  amount        Int
  referenceCode String    @unique // shown to buyer, referenced in manual confirmation / Discord
  proofUrl      String?   // optional payment proof uploaded by buyer
  confirmedById String?   // admin user id who manually confirmed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime?
}

model Download {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productFileId String
  productFile   ProductFile @relation(fields: [productFileId], references: [id])
  downloadedAt  DateTime  @default(now())
  ipAddress     String?

  @@index([userId])
  @@index([productFileId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Roblox accounts allowed to run the "Marching" command system in the
// antitest Roblox place. Checked by robloxUserId (not just username, which
// can change) via GET /api/roblox-whitelist -- see that route and
// ServerScriptService.Main's security gate in the Roblox place itself.
model RobloxWhitelist {
  id             String   @id @default(cuid())
  robloxUsername String   // snapshot at time of adding, for display only
  robloxUserId   String   @unique
  note           String?
  createdAt      DateTime @default(now())

  sessions       RobloxAssetSession[]

  @@index([robloxUserId])
}

// Live "where is this asset currently running" telemetry, reported by the
// asset's own security gate script via POST /api/roblox-whitelist/heartbeat
// on the same interval it re-checks the whitelist (see ServerScriptService.Main
// in the Roblox place). One row per (whitelisted account, asset, place) --
// re-reported on every heartbeat, not appended, so this only ever reflects
// the latest sighting, never a history log. assetKey defaults to "marching"
// (the only asset wired up today) but exists so other assets can reuse the
// same whitelist account + gate pattern under their own key and show up
// side by side in the admin live-tracking table.
model RobloxAssetSession {
  id          String   @id @default(cuid())
  whitelistId String
  whitelist   RobloxWhitelist @relation(fields: [whitelistId], references: [id], onDelete: Cascade)
  assetKey    String   @default("marching")
  placeId     String
  placeName   String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([whitelistId, assetKey, placeId])
  @@index([lastSeenAt])
}

model Appeal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  status     String    @default("PENDING") // PENDING | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([status])
}

// ---------- Topup (game diamond/currency topup) ----------
// A separate, self-contained subsystem from Product/Order: buyers pick a
// game, then a denomination, then pay directly (no cart, one order per
// purchase). Managed from its own admin page, not the Products admin.

model TopupGame {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?  // banner/logo image url shown on the game card
  description String?
  status      String   @default("DRAFT") // PUBLISHED | DRAFT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       TopupItem[]

  @@index([status])
}

model TopupItem {
  id        String   @id @default(cuid())
  gameId    String
  game      TopupGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String    // e.g. "86 Diamond"
  price     Int
  status    String    @default("PUBLISHED") // PUBLISHED | DRAFT
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    TopupOrder[]

  @@index([gameId])
}

model TopupOrder {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topupItemId   String?
  topupItem     TopupItem? @relation(fields: [topupItemId], references: [id], onDelete: SetNull)
  gameName      String    // snapshot at time of purchase
  itemName      String    // snapshot at time of purchase
  price         Int       // snapshot at time of purchase
  targetId      String    // buyer's game account/user ID
  serverId      String?   // buyer's zone/server ID, when the game needs one
  buyerName     String
  buyerEmail    String
  buyerContact  String
  method        String    // QRIS | GOPAY | OVO | DANA | SHOPEEPAY | BANK_TRANSFER | VIRTUAL_ACCOUNT
  referenceCode String    @unique
  status        String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | EXPIRED
  proofUrl      String?   // required payment proof uploaded by buyer
  confirmedById String?   // admin user id who manually confirmed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?
  expiresAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
}
