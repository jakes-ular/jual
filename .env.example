# Database (PostgreSQL — e.g. Neon, Vercel Postgres, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob (file storage). Leave unset for local dev to fall back to the
# local filesystem under public/uploads. Required in production.
BLOB_READ_WRITE_TOKEN=""

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Discord webhook — used to notify admins of new orders / payment confirmations
# instead of a live payment gateway integration. Create one in your Discord
# server: Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=""

# Signed download links
DOWNLOAD_TOKEN_SECRET="replace-with-a-long-random-string"

# Gmail SMTP — used to send the registration verification code. Uses your own
# Gmail account so no custom domain/DNS verification is required. Enable
# 2-Step Verification on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and use it here (not your login
# password).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Seed / bootstrap admin account
ADMIN_EMAIL="admin@voxmarket.dev"
ADMIN_PASSWORD="Admin123!"

# Public site URL (used for SEO metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VoxMarket"

# Sentry (error monitoring, src/instrumentation.ts + src/instrumentation-client.ts).
# DSNs come from your Sentry project's Client Keys settings. Sentry.init with
# no DSN simply no-ops, so these can stay empty until a Sentry project exists.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed at build time to upload source maps — set as a CI/Vercel
# secret, not committed to a real .env file.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
